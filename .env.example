# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# DashScope (Alibaba Cloud Bailian) OpenAI-compatible API key.
# Used by text models (S1 skeleton / S2 relations / S4 docs / S5 cross-chapter)
# and the vision model (S0.5 image description).
DASHSCOPE_API_KEY=

# MinerU API token. Only needed when the S-1 stage must convert a PDF to full.md
# automatically (i.e. no MinerU full.md output exists yet).
MINERU_API_TOKEN=

# --- optional overrides ---
# LLM_MODEL=qwen3.7-plus
# MINERU_BASE_URL=https://mineru.net/api/v4
